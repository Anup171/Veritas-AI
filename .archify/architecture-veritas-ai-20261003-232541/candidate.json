  "cards": [
    {
      "dot": "cyan",
      "title": "Interactive Frontend & Orchestration",
      "items": [
        "Chainlit UI provides real-time WebSocket progress tracking, stage badges, and action callbacks",
        "LangGraph StateGraph manages sequential agent transitions and state recovery",
        "Singleton ProgressCallback emits stage updates to the interactive chat timeline"
      ]
    },
    {
      "dot": "emerald",
      "title": "Multi-Agent Pipeline & Concurrency",
      "items": [
        "ResearchPlanner structures search objectives, targeted queries, and outline sections",
        "ResearchSearcher dispatches parallel asyncio.gather tasks for web search and content extraction",
        "CredibilityScorer filters low-quality domains based on institutional authority",
        "ResearchSynthesizer and ReportWriter compile verified findings with APA/MLA citations"
      ]
    },
    {
      "dot": "amber",
      "title": "External Providers & Security",
      "items": [
        "Dynamic LLM factory supports Google Gemini, Groq, OpenAI, and local Ollama / llama.cpp",
        "DuckDuckGo and Tavily providers queried concurrently without storing provider keys in code",
        "Target websites crawled via async httpx client with HTTP/2 and BeautifulSoup4 parsing"
      ]
    },
    {
      "dot": "violet",
      "title": "Persistence & Infrastructure",
      "items": [
        "SqliteSaver persists workflow checkpoints in .cache/checkpoints/ for crash recovery",
        "File-based cache (.cache/research/) eliminates duplicate searches across 7-day TTL",
        "Docker container runs as unprivileged appuser (UID 10001) exposing port 8000",
        "Exported reports saved to host volume in Markdown, styled HTML, and Plain Text"
      ]
    }
  ]
