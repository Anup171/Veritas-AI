# Credentials and local configuration
.env
.env.*
!.env.example

# Python environments and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Runtime data and generated reports
.cache/
.files/
outputs/

# Keep only the Chainlit configuration explicitly copied by the Dockerfile.
.chainlit/*
!.chainlit/config.toml

# Source control and editor metadata
.git/
.gitignore
.vscode/
.idea/

# Test and coverage artifacts
.pytest_cache/
.coverage
coverage/

# Documentation and local assets are not needed to run the application image.
README.md
LICENSE
assets/
pyproject.toml
